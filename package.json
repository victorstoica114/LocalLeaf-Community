{
  "name": "localleaf",
  "displayName": "LocalLeaf",
  "description": "Local LaTeX Editing yet Synced to Overleaf",
  "version": "0.1.3",
  "publisher": "teddy-van-jerry",
  "repository": {
    "type": "git",
    "url": "https://github.com/Teddy-van-Jerry/LocalLeaf"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "latex",
    "overleaf",
    "sync",
    "tex"
  ],
  "activationEvents": [
    "workspaceContains:.localleaf",
    "onView:localleaf.projectsView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localleaf",
          "title": "LocalLeaf",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "localleaf": [
        {
          "id": "localleaf.projectsView",
          "name": "Projects",
          "when": "!localleaf.isLinked"
        },
        {
          "id": "localleaf.changesView",
          "name": "Changes",
          "when": "localleaf.isLinked"
        },
        {
          "id": "localleaf.detailsView",
          "name": "Details",
          "when": "localleaf.isLinked",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "localleaf.projectsView",
        "contents": "Login to Overleaf to see your projects.\n[Login to Overleaf](command:localleaf.login)",
        "when": "!localleaf.loggedIn"
      },
      {
        "view": "localleaf.changesView",
        "contents": "No file changes yet.\nChanges will appear here as files are synced.",
        "when": "localleaf.isLinked"
      }
    ],
    "commands": [
      {
        "command": "localleaf.login",
        "title": "LocalLeaf: Login"
      },
      {
        "command": "localleaf.logout",
        "title": "LocalLeaf: Logout",
        "icon": "$(sign-out)"
      },
      {
        "command": "localleaf.linkFolder",
        "title": "LocalLeaf: Link Folder to Overleaf Project"
      },
      {
        "command": "localleaf.unlinkFolder",
        "title": "LocalLeaf: Unlink Folder",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "localleaf.syncNow",
        "title": "LocalLeaf: Sync Now",
        "icon": "$(sync)"
      },
      {
        "command": "localleaf.pullFromOverleaf",
        "title": "LocalLeaf: Pull from Overleaf",
        "icon": "$(cloud-download)"
      },
      {
        "command": "localleaf.pushToOverleaf",
        "title": "LocalLeaf: Push to Overleaf",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "localleaf.editIgnorePatterns",
        "title": "LocalLeaf: Edit Ignore Patterns",
        "icon": "$(list-filter)"
      },
      {
        "command": "localleaf.showSyncStatus",
        "title": "LocalLeaf: Show Sync Status"
      },
      {
        "command": "localleaf.setMainDocument",
        "title": "LocalLeaf: Set Main Document"
      },
      {
        "command": "localleaf.configure",
        "title": "LocalLeaf: Configure Settings"
      },
      {
        "command": "localleaf.jumpToCollaborator",
        "title": "LocalLeaf: Jump to Collaborator"
      },
      {
        "command": "localleaf.verifyCredentials",
        "title": "LocalLeaf: Verify Credentials"
      },
      {
        "command": "localleaf.refreshCookie",
        "title": "LocalLeaf: Refresh Cookie"
      },
      {
        "command": "localleaf.openProject",
        "title": "LocalLeaf: Open Project"
      },
      {
        "command": "localleaf.removeComments",
        "title": "LocalLeaf: Remove LaTeX Comments",
        "icon": "$(comment-unresolved)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "localleaf.syncNow",
          "when": "view == localleaf.changesView",
          "group": "navigation@1"
        },
        {
          "command": "localleaf.pullFromOverleaf",
          "when": "view == localleaf.changesView",
          "group": "navigation@2"
        },
        {
          "command": "localleaf.pushToOverleaf",
          "when": "view == localleaf.changesView",
          "group": "navigation@3"
        },
        {
          "command": "localleaf.editIgnorePatterns",
          "when": "view == localleaf.changesView",
          "group": "1_actions@1"
        },
        {
          "command": "localleaf.removeComments",
          "when": "view == localleaf.changesView",
          "group": "1_actions@2"
        },
        {
          "command": "localleaf.unlinkFolder",
          "when": "view == localleaf.changesView",
          "group": "2_manage@1"
        },
        {
          "command": "localleaf.logout",
          "when": "view == localleaf.changesView && localleaf.loggedIn",
          "group": "2_manage@2"
        },
        {
          "command": "localleaf.logout",
          "when": "view == localleaf.projectsView && localleaf.loggedIn",
          "group": "2_manage@1"
        },
        {
          "command": "localleaf.removeComments",
          "when": "view == localleaf.detailsView",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "LocalLeaf",
      "properties": {
        "localleaf.defaultServer": {
          "type": "string",
          "default": "https://www.overleaf.com",
          "description": "Default Overleaf server URL"
        },
        "localleaf.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic sync when files change"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "postinstall": "patch-package",
    "website:dev": "npm run dev --prefix docs/website",
    "website:build": "npm run build --prefix docs/website"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.9",
    "@types/socket.io-client": "^1.4.36",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "patch-package": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "form-data": "^4.0.0",
    "mime-types": "^2.1.35",
    "minimatch": "^9.0.3",
    "node-fetch": "^2.7.0",
    "socket.io-client": "github:overleaf/socket.io-client#0.9.17-overleaf-5"
  }
}
